# Copy to .env and fill in. docker-compose reads this file automatically.

# Comma-separated Fernet keys. First key encrypts new writes; all keys decrypt.
# Generate via:   python -m bluewave.keygen
CONFIG_ENC_KEYS=

# Operator web UI Basic Auth.
WEB_USER=admin
# Generate via:   python -m bluewave.hashpw
WEB_PASS_HASH=

# Required acknowledgment of HTTP-only posture (spec L13).
WEB_ALLOW_HTTP=1

# Optional overrides.
# TZ=UTC                          # must remain UTC (spec L17)
# LOG_LEVEL=INFO                  # one of DEBUG/INFO/WARNING/ERROR
# CATCH_UP_CAP_DAYS=14
# BACKFILL_SAFETY_CAP_DAYS=365
